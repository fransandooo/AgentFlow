# Domain
APP_DOMAIN=agentflow.fransando.cloud

# Postgres
POSTGRES_DB=agentflow
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://agentflow:change-me@postgres:5432/agentflow

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# API
PORT=3001
NODE_ENV=production

# Web
NEXT_PUBLIC_API_URL=https://agentflow.fransando.cloud/api/v1
NEXT_PUBLIC_WS_URL=https://agentflow.fransando.cloud/ws
